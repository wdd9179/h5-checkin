APP_NAME=晚间签到
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=zh
APP_FALLBACK_LOCALE=zh
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----- 数据库 -----
# 本地开发用 SQLite
DB_CONNECTION=sqlite
# 生产切换 MySQL
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=chaqin
# DB_USERNAME=chaqin
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ----- 微信 OAuth -----
# 第一版：保持 WECHAT_OAUTH_ENABLED=false，自动用 cookie 模拟 openid
# 拿到 AppID 后：填下面两个变量、改为 true
WECHAT_OAUTH_ENABLED=false
WECHAT_OFFICIAL_APPID=
WECHAT_OFFICIAL_SECRET=

# Cookie 中伪 openid 的 key 名 (第一版无 AppID 时使用)
MOCK_OPENID_COOKIE=chaqin_openid

# ----- 管理员初始账号 -----
# 首次启动时 (users 表为空) 自动创建
ADMIN_NAME=管理员
ADMIN_EMAIL=admin@chaqin.local
ADMIN_PASSWORD=admin123456

# ----- 邮件 (默认用 log driver，不发真邮件) -----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@chaqin.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
